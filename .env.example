# Template konfigurasi. Copy ke .env lalu sesuaikan.
# Semua nilai punya default di src/roof_inference/core/config.py.

APP_NAME=Sunsight
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Path relatif terhadap package roof_inference
MODEL_PATH=src/roof_inference/weights/best.pt
MODEL_DEVICE=cpu
MODEL_CONFIDENCE=0.25
# Model dilatih pada imgsz=1024; 640 tidak menemukan bidang atap sama sekali pada
# citra ubin zoom 19, dan 1280 adalah yang terbaik dari yang diukur.
MODEL_IMAGE_SIZE=1280
MODEL_VERSION=latest

# Rahasia bersama yang wajib dikirim backend pada header X-Api-Key. Kosong berarti
# pemeriksaan dimatikan; isi nilainya saat layanan dapat dijangkau dari internet.
ML_API_KEY=

MAX_IMAGE_SIZE=10485760
MAX_IMAGE_PIXELS=20000000
MAX_CONCURRENT_INFERENCES=1

LOG_LEVEL=INFO
